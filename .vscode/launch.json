{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug kkc",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin",
          "kkc"
        ],
        "filter": {
          "name": "kkc",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "terminal": "external"
    },
    {
      "name": "Debug kkc (smb feature)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin",
          "kkc",
          "--features",
          "smb"
        ],
        "filter": {
          "name": "kkc",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated"
    },
    {
      "name": "Debug current Rust test",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--bin",
          "kkc",
          "--no-run"
        ],
        "filter": {
          "name": "kkc",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}